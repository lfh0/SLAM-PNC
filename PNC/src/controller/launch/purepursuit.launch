<launch>
    <rosparam command="load" file="$(find controller)/config/purepursuit.yaml" />
    <rosparam command="load" file="$(find controller)/config/controller_server.yaml" />
    <node pkg="controller" type="controller_server" name="controller_server" output="screen">
        <param name="path_topic" value="/trajopt/debug_path" />
        <param name="trajectory_topic" value="/trajopt/minco_traj" />
        <param name="odom_topic" value="/lio/robo/odom" />
    </node>
</launch>
